{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "seo-pulse": {
      "type": "streamable-http",
      "url": "https://pulse.lslabs.tw/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {"mode": "dcr"},
            "baseScopes": ["seo-pulse.read"]
          }
        }
      }
    }
  }
}
